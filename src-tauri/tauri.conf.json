{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibva",
  "version": "0.1.0",
  "identifier": "com.geekmai.nibva",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nibva",
        "width": 1360,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
