{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "落笔",
  "mainBinaryName": "Loby",
  "version": "0.6.0",
  "identifier": "com.geekmai.loby",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "落笔",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 720,
        "maximized": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost http: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https://api.github.com https://img.shields.io",
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/Loby/generated-images/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../skills/": "skills/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMzQzOEUxNDQ1QUI2MkYKUldRdnRscEU0VGcwYTJ4ZTZnSlBTS0xXSFN0UEZXZzY5MElaTTB5eTJaU2ttdWc0N3FjYjdVa2oK",
      "endpoints": [
        "https://gitee.com/geekmai/Loby-Releases/raw/master/updates/{{target}}-{{arch}}/latest.json",
        "https://github.com/GeekMai90/Loby/releases/latest/download/latest.json"
      ]
    }
  }
}
