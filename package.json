{
  "name": "loby",
  "version": "0.6.0",
  "description": "Loby is a local-first, Markdown-based professional writing app designed for AI-friendly human writing workflows.",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tauri dev",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "node scripts/build-tauri.mjs",
    "release": "node scripts/release-version.mjs",
    "release:build": "node scripts/build-release-platform.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:mirror": "node scripts/mirror-release.mjs",
    "build:web": "tsc && vite build && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write && npm run format:rust",
    "format:check": "prettier . --check && npm run format:rust:check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:cli": "npm test --prefix cli",
    "test:release": "node --test scripts/release-version.test.mjs scripts/release-config.test.mjs scripts/release-pipeline.test.mjs scripts/desktop-security-config.test.mjs scripts/project-health.test.mjs",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "audit:npm": "npm audit --audit-level=moderate",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "report:health": "node scripts/project-health.mjs",
    "ui:add": "shadcn add",
    "ui:info": "shadcn info",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "check": "npm run format:check && npm run check:architecture && npm run typecheck && npm run lint && npm run test && npm run test:release && npm run test:cli && npm run build:web && npm run check:rust && npm run test:rust && npm run lint:rust",
    "cli": "node cli/src/cli.mjs",
    "pack:cli": "npm pack ./cli",
    "preview": "vite preview --host 127.0.0.1"
  },
  "homepage": "https://github.com/GeekMai90/Loby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeekMai90/Loby.git"
  },
  "bugs": {
    "url": "https://github.com/GeekMai90/Loby/issues"
  },
  "keywords": [
    "tauri",
    "markdown",
    "writing",
    "local-first",
    "desktop"
  ],
  "author": "麦先生",
  "license": "ISC",
  "dependencies": {
    "@assistant-ui/react": "^0.15.25",
    "@assistant-ui/react-markdown": "^0.14.19",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/react": "^0.27.20",
    "@lezer/markdown": "^1.8.0",
    "@lobehub/icons": "^5.23.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@uiw/react-codemirror": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^8.0.4",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.2.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-use-measure": "^2.1.7",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  }
}
